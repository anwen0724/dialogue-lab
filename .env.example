# 修改后重启后端；系统指令正文修改无需重启。
DIALOGUE_LAB_APP_NAME=Dialogue Lab
# 首次启动前替换密码。URL 引用上面的密码，保留这两行的顺序。
# 使用字母和数字组成的密码，避免 URL 特殊字符需要额外编码。
POSTGRES_PASSWORD=replace-with-local-password
DIALOGUE_LAB_DATABASE_URL=postgresql+asyncpg://dialogue_lab:${POSTGRES_PASSWORD}@127.0.0.1:5432/dialogue_lab

# 对话模型：首次启动时导入 data/settings.json，此后在首页“应用设置”中修改。
DIALOGUE_LAB_AI_PROVIDER=deepseek
DIALOGUE_LAB_AI_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
DIALOGUE_LAB_AI_MAX_OUTPUT_TOKENS=4096
# 可选：只填所选模型支持的档位；未设置时采用供应商默认行为。
# DIALOGUE_LAB_AI_REASONING=off
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# 百炼识别与合成均使用本供应商密钥。
DASHSCOPE_API_KEY=
DIALOGUE_LAB_STT_MODEL=qwen-audio-3.1-asr-flash-streaming
DIALOGUE_LAB_TTS_MODEL=qwen-audio-3.1-tts-flash
# 用于数据库迁移回填已有场景，以及无场景的旧会话；场景人物声音在界面中选择。
DIALOGUE_LAB_TTS_VOICE=longanhuan_v3.1
# 默认读取根目录 prompts/ 下的 Markdown 正文。
# DIALOGUE_LAB_PROMPTS_DIRECTORY=C:/path/to/prompts

# 应用设置、用户场景身份文档和图片；默认保存在项目根目录 data/。
# DIALOGUE_LAB_DATA_DIRECTORY=C:/path/to/dialogue-data
