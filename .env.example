# 修改后重启后端；系统指令正文修改无需重启。
DIALOGUE_LAB_APP_NAME=Dialogue Lab
DIALOGUE_LAB_DATABASE_URL=postgresql+asyncpg://dialogue:dialogue@127.0.0.1:5432/dialogue_lab

# 对话模型：使用内置供应商目录。
DIALOGUE_LAB_AI_PROVIDER=deepseek
DIALOGUE_LAB_AI_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
DIALOGUE_LAB_AI_MAX_OUTPUT_TOKENS=4096
# 可选：只填所选模型支持的档位；未设置时采用供应商默认行为。
# DIALOGUE_LAB_AI_REASONING=off
# DIALOGUE_LAB_AI_API_KEY=覆盖当前调用的密钥
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# 百炼语音；TTS 未单独填密钥时使用 STT 密钥。
DIALOGUE_LAB_STT_API_KEY=
DIALOGUE_LAB_STT_MODEL=qwen-audio-3.1-asr-flash-streaming
DIALOGUE_LAB_TTS_API_KEY=
DIALOGUE_LAB_TTS_MODEL=qwen-audio-3.1-tts-flash
DIALOGUE_LAB_TTS_VOICE=longanhuan_v3.1
# 默认读取根目录 prompts/ 下的 Markdown 正文。
# DIALOGUE_LAB_PROMPTS_DIRECTORY=C:/path/to/prompts
